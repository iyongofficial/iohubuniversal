verifyBtn.MouseButton1Click:Connect(function()
	local enteredKey = keyInput.Text
	local correctKey = _G_KeyInput 
	
	-- Smart Check: Works in both Studio AND Executors
	local isStudio = game:GetService("RunService"):IsStudio()
	
	if isStudio then
		print("⚠️ STUDIO DETECTED: Using hardcoded key " .. _G_KeyInput)
	elseif _G_PastebinLink ~= "" then
		local success, result = pcall(function() return game:HttpGet(_G_PastebinLink) end)
		if success then 
			-- Removes spaces/newlines from Pastebin result
			correctKey = string.gsub(result, "^%s*(.-)%s*$", "%1") 
		end
	end
	
	if enteredKey == correctKey then
		statusLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
		statusLabel.Text = "SUCCESS!"
		wait(0.5)
		keyFrame:TweenPosition(UDim2.new(0.5, -150, 1.5, 0), "In", "Back", 0.5, true)
		wait(0.5)
		keyFrame.Visible = false
		mainFrame.Visible = true
		mainFrame.Size = UDim2.new(0,0,0,0)
		mainFrame:TweenSize(UDim2.new(0,500,0,350), "Out", "Back", 0.3, true)
	else
		statusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
		statusLabel.Text = "INCORRECT KEY"
		keyInput.Text = ""
	end
end)

