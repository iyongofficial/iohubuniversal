createFeatureBtn("Esp", miscPage, function()
	-- Esp Logic Example
	local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local function createESP(player, character)
    if not character:FindFirstChild("Head") then return end
    
    -- 1. Create the Highlight (The Outline)
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESPHighlight"
    highlight.Adornee = character
    highlight.FillColor = Color3.fromRGB(255, 0, 0)
    highlight.FillTransparency = 0.5
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character

    -- 2. Create the Name Tag (BillboardGui)
    local bgui = Instance.new("BillboardGui")
    bgui.Name = "ESPNameTag"
    bgui.Adornee = character:WaitForChild("Head")
    bgui.Size = UDim2.new(0, 100, 0, 50)
    bgui.StudsOffset = Vector3.new(0, 3, 0) -- Positions name above head
    bgui.AlwaysOnTop = true -- Makes it visible through walls
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Parent = bgui
    textLabel.BackgroundTransparency = 1
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.Text = player.Name
    textLabel.TextColor3 = Color3.new(1, 1, 1) -- White
    textLabel.TextStrokeTransparency = 0 -- Adds a black outline for readability
    textLabel.TextScaled = true
    textLabel.Font = Enum.Font.SourceSansBold

    bgui.Parent = character
end

local function onPlayerAdded(player)
    player.CharacterAdded:Connect(function(character)
        createESP(player, character)
    end)
    
    if player.Character then
        createESP(player, player.Character)
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        onPlayerAdded(player)
    end
end

Players.PlayerAdded:Connect(onPlayerAdded)


end,
   
})



createFeatureBtn("Fly", miscPage, function()
	-- Fly Logic Placeholder
	local player = game.Players.LocalPlayer
local char = player.Character or player.CharacterAdded:Wait()
local root = char:WaitForChild("HumanoidRootPart")
local hum = char:WaitForChild("Humanoid")
local camera = workspace.CurrentCamera
local RunService = game:GetService("RunService")

-- Cleanup old physics objects
for _, v in pairs(root:GetChildren()) do
    if v:IsA("BodyVelocity") or v:IsA("BodyGyro") then v:Destroy() end
end

-- 1. JETPACK ENGINE (BodyVelocity)
local bv = Instance.new("BodyVelocity")
bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge) -- Stops gravity 100%
bv.Velocity = Vector3.new(0, 0, 0)
bv.Parent = root

-- 2. STABILIZER (Keeps you upright)
local bg = Instance.new("BodyGyro")
bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
bg.P = 20000 -- Makes it snap to camera direction quickly
bg.Parent = root

local speed = 500 -- Adjust for flight speed

RunService.RenderStepped:Connect(function()
    root.Anchored = false
    hum.PlatformStand = true -- Necessary for smooth flight physics
    
    -- This is the key for Mobile: 
    -- We use MoveDirection which Roblox already calculates from your joystick
    local moveDir = hum.MoveDirection 
    
    if moveDir.Magnitude > 0 then
        -- We calculate direction based on where the joystick is pointing 
        -- but we tilt the movement based on the camera's vertical angle
        local cameraCF = camera.CFrame
        local look = cameraCF.LookVector
        
        -- If you are pushing forward, we follow the camera's tilt
        -- If you are moving side-to-side, we stay level
        local flyDir = Vector3.new(moveDir.X, look.Y * (moveDir:Dot(cameraCF.LookVector) > 0 and 1 or -1), moveDir.Z)
        
        -- If the camera is tilted, we move you in that 3D direction
        bv.Velocity = moveDir * speed + Vector3.new(0, look.Y * speed * (moveDir:Dot(cameraCF.LookVector)), 0)
    else
        -- Stop instantly when you let go of the joystick
        bv.Velocity = Vector3.new(0, 0, 0)
    end
    
    -- Keep the character facing exactly where the camera points
    bg.CFrame = camera.CFrame
end)

   end,
})

