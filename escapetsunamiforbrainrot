-- // TAB SELECTION LOGIC //
local allTabs = {}

local function SelectTab(selectedBtn, targetPage)
	for _, btn in pairs(allTabs) do
		btn.BackgroundTransparency = 1
		btn.TextColor3 = Color3.new(1,1,1)
		btn.TextStrokeTransparency = 0
		if btn:FindFirstChild("ActiveCorner") then btn.ActiveCorner:Destroy() end
	end
	
	selectedBtn.BackgroundTransparency = 0
	selectedBtn.BackgroundColor3 = Color3.fromRGB(170, 255, 0)
	selectedBtn.TextColor3 = Color3.new(0,0,0)
	selectedBtn.TextStrokeTransparency = 1
	
	local corner = Instance.new("UICorner")
	corner.Name = "ActiveCorner"
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = selectedBtn
	
	mainPage.Visible = false
	miscPage.Visible = false
	tpPage.Visible = false
	targetPage.Visible = true
end

local function createTab(text, order, linkedPage)
	local tab = Instance.new("TextButton")
	tab.LayoutOrder = order
	tab.Text = text
	tab.Font = Enum.Font.FredokaOne
	tab.TextSize = 20
	tab.Size = UDim2.new(0, 100, 0, 30)
	tab.BackgroundTransparency = 1
	tab.TextColor3 = Color3.new(1,1,1)
	tab.TextStrokeTransparency = 0
	tab.Parent = navList
	
	table.insert(allTabs, tab)
	tab.MouseButton1Click:Connect(function() SelectTab(tab, linkedPage) end)
	return tab
end

