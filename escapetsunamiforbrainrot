local allTabs = {}

local function SelectTab(selectedBtn, targetPage)
	-- 1. Reset all tabs visuals
	for _, btn in pairs(allTabs) do
		btn.BackgroundTransparency = 1
		btn.TextColor3 = Color3.new(1,1,1)
		if btn:FindFirstChild("ActiveStyle") then btn.ActiveStyle:Destroy() end
		if btn:FindFirstChild("ActiveCorner") then btn.ActiveCorner:Destroy() end
	end

	-- 2. Highlight selected tab
	selectedBtn.BackgroundTransparency = 0
	selectedBtn.TextColor3 = Color3.new(0,0,0)

	local corner = Instance.new("UICorner")
	corner.Name = "ActiveCorner"
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = selectedBtn

	local grad = Instance.new("UIGradient")
	grad.Name = "ActiveStyle"
	grad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(150, 255, 50)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 255, 0))
	})
	grad.Parent = selectedBtn

	-- 3. Switch Pages (Hide all, show target)
	mainPage.Visible = false
	miscPage.Visible = false
	tpPage.Visible = false

	targetPage.Visible = true
end

local function createTab(text, order, linkedPage)
	local tab = Instance.new("TextButton")
	tab.LayoutOrder = order
	tab.Text = text
	tab.Font = Enum.Font.FredokaOne
	tab.TextSize = 18
	tab.Size = UDim2.new(0, 80, 1, 0)
	tab.BackgroundTransparency = 1
	tab.TextColor3 = Color3.new(1,1,1)
	tab.Parent = navContainer
	table.insert(allTabs, tab)

	tab.MouseButton1Click:Connect(function() 
		SelectTab(tab, linkedPage) 
	end)

	return tab
end

