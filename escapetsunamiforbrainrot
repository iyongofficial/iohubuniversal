-- // HELPER: Create Toggle (For Main Tab) //
local function createToggle(text, parentPage)
	local toggleBtn = Instance.new("TextButton")
	toggleBtn.Size = UDim2.new(0.9, 0, 0, 40)
	toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40) -- Dark Grey (Off)
	toggleBtn.Text = text .. " [OFF]"
	toggleBtn.TextColor3 = Color3.new(1, 1, 1)
	toggleBtn.Font = Enum.Font.FredokaOne
	toggleBtn.TextSize = 18
	toggleBtn.Parent = parentPage

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = toggleBtn

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(60, 60, 60)
	stroke.Thickness = 2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = toggleBtn

	local toggled = false

	toggleBtn.MouseButton1Click:Connect(function()
		toggled = not toggled
		if toggled then
			-- ON STATE
			toggleBtn.Text = text .. " [ON]"
			toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50) -- Green
			print(text .. " ENABLED")
			-- Add your loop code here (e.g., while toggled do ...)
		else
			-- OFF STATE
			toggleBtn.Text = text .. " [OFF]"
			toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40) -- Grey
			print(text .. " DISABLED")
		end
	end)
end

